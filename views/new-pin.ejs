<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Create Pin — Pinboard</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <h1><a href="/">📌 Pinboard</a></h1>
      <div class="nav-actions">
        <a href="/" class="btn btn-outline">Back to Feed</a>
      </div>
    </header>

    <div class="container" style="max-width: 600px; margin-top: 40px">
      <div
        style="
          background: var(--bg-slate);
          border: 1px solid var(--border-subtle);
          padding: 40px;
          border-radius: 20px;
          box-shadow: var(--shadow);
        "
      >
        <h2 style="margin-top: 0; margin-bottom: 24px; font-size: 1.5rem">
          Create a New Pin
        </h2>
        <form action="/pins" method="POST">
          <div style="margin-bottom: 20px">
            <label
              style="
                display: block;
                margin-bottom: 8px;
                color: var(--text-muted);
                font-size: 0.9rem;
              "
              >Pin Title</label
            >
            <input
              type="text"
              name="title"
              placeholder="Give your pin a catchy title..."
              required
              style="
                width: 100%;
                padding: 12px 16px;
                border-radius: 10px;
                border: 1px solid var(--border-subtle);
                background: var(--bg-navy);
                color: var(--text-ice);
                font-size: 1rem;
                outline: none;
              "
            />
          </div>
          <div style="margin-bottom: 30px">
            <label
              style="
                display: block;
                margin-bottom: 8px;
                color: var(--text-muted);
                font-size: 0.9rem;
              "
              >Image URL</label
            >
            <input
              type="url"
              name="imageUrl"
              placeholder="https://example.com/image.jpg"
              required
              style="
                width: 100%;
                padding: 12px 16px;
                border-radius: 10px;
                border: 1px solid var(--border-subtle);
                background: var(--bg-navy);
                color: var(--text-ice);
                font-size: 1rem;
                outline: none;
              "
            />
          </div>
          <button
            type="submit"
            class="btn"
            style="
              width: 100%;
              padding: 14px;
              font-size: 1rem;
              border-radius: 10px;
            "
          >
            Publish Pin
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
