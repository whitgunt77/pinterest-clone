<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= profileUser.displayName || profileUser.username %>'s Profile — Pinboard</title>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
  <script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
  <link rel="stylesheet" href="/style.css">
  <style>
    .profile-card-header {
      background: var(--bg-slate);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 40px;
      text-align: center;
      max-width: 500px;
      margin: 0 auto 50px auto;
      box-shadow: var(--shadow);
    }
    .profile-avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid var(--accent-sky);
      object-fit: cover;
      margin-bottom: 16px;
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
    }
  </style>
</head>
<body>

  <header>
    <h1><a href="/">📌 Pinboard</a></h1>
    <div class="nav-actions">
      <a href="/" class="btn btn-outline">Explore Feed</a>
      <% if (user) { %>
        <a href="/pins/new" class="btn btn-outline">+ New Pin</a>
        <a href="/logout" class="btn btn-outline" style="border-color: #EF4444 !important; color: #EF4444 !important;">Log Out</a>
      <% } else { %>
        <a href="/auth/github" class="btn">Login with GitHub</a>
      <% } %>
    </div>
  </header>

  <div class="container">
    <div class="profile-card-header">
      <% if (profileUser.avatarUrl) { %>
        <img src="<%= profileUser.avatarUrl %>" alt="<%= profileUser.username %>" class="profile-avatar">
      <% } %>
      <h2 style="margin: 0 0 6px 0; font-size: 1.75rem;"><%= profileUser.displayName || profileUser.username %></h2>
      <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">@<%= profileUser.username %> • <%= pins.length %> Pins</p>
    </div>

    <% if (pins && pins.length > 0) { %>
      <div class="grid">
        <div class="grid-sizer"></div>
        <% pins.forEach(pin => { %>
          <div class="pin-card">
            <a href="/pin/<%= pin._id %>">
              <img src="<%= pin.imageUrl %>" alt="<%= pin.title %>" onerror="this.onerror=null; this.src='https://placehold.co/600x400/0F172A/38BDF8?text=Image+Unavailable';">
            </a>
            <div class="pin-body">
              <a href="/pin/<%= pin._id %>" class="pin-title"><%= pin.title %></a>
              <div class="pin-footer">
                <span><%= new Date(pin.createdAt).toLocaleDateString() %></span>
                <% if (user && pin.owner && pin.owner._id.toString() === user._id.toString()) { %>
                  <form action="/pins/delete/<%= pin._id %>" method="POST" style="margin:0;">
                    <button type="submit" class="delete-btn">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="text-align: center; color: var(--text-muted); margin-top: 40px;">No pins on this wall yet.</p>
    <% } %>
  </div>

  <script>
    $(document).ready(function() {
      var $grid = $('.grid').imagesLoaded(function() {
        $grid.masonry({
          itemSelector: '.pin-card',
          columnWidth: '.grid-sizer',
          percentPosition: true,
          gutter: 20
        });
      });
    });
  </script>

</body>
</html>